
# Database Configuration
DATABASE_PATH=data/juldyz.db

# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LOG_LEVEL=info

# Form Service Configuration
FORM_SERVICE_URL=http://0.0.0.0
FORM_SERVICE_PORT=8001
FORM_SERVICE_LOG_LEVEL=debug

# Bot Service Configuration
BOT_SERVICE_URL=http://0.0.0.0
BOT_SERVICE_PORT=8002
BOT_SERVICE_LOG_LEVEL=info

# Dashboard Service Configuration
DASHBOARD_SERVICE_URL=http://0.0.0.0
DASHBOARD_SERVICE_PORT=8006
DASHBOARD_SERVICE_LOG_LEVEL=info

# Scoring Service Configuration
SCORING_SERVICE_URL=http://0.0.0.0
SCORING_SERVICE_PORT=8003
SCORING_SERVICE_LOG_LEVEL=warning

# Parser Service Configuration
PARSER_SERVICE_URL=http://0.0.0.0
PARSER_SERVICE_PORT=8004
PARSER_SERVICE_LOG_LEVEL=error

# LLM Service Configuration
LLM_SERVICE_URL=http://0.0.0.0
LLM_SERVICE_PORT=8005
LLM_SERVICE_LOG_LEVEL=warning
LLM_MODEL_PATH=models/llm
LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
LLM_HF_TOKEN=HuggingFace_Token
LLM_MODE=2

# Dashboard Service Configuration
DASHBOARD_SERVICE_URL=http://0.0.0.0
DASHBOARD_SERVICE_PORT=8501
DASHBOARD_SERVICE_LOG_LEVEL=info
DASHBOARD_SERVICE_PAGE_PORT=8502

# Telegram Bot Configuration
TELEGRAM_TOKEN=BOT_FATHER_TOKEN

# Google Form URL
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/GOOGLE_FORM_ID/viewform
QUESTION_FIELD_ID=GOOGLE_FORM_QUESTION_FIELD_ID

# Optional Google Drive auth for private file-upload links returned by Google Forms.
# Use either a short-lived OAuth bearer token or a browser cookie string from the owner account.
GOOGLE_DRIVE_BEARER_TOKEN=
GOOGLE_DRIVE_COOKIE=
GOOGLE_DRIVE_DOWNLOAD_TIMEOUT_SECONDS=90

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATA_DIR=/data/redis
REDIS_APPENDONLY=yes

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
