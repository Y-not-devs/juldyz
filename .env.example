
# Database Configuration
DATABASE_PATH=data/juldyz.db

# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LOG_LEVEL=info

# Form Service Configuration
FORM_SERVICE_URL=http://localhost:8001
FORM_SERVICE_PORT=8001
FORM_SERVICE_LOG_LEVEL=debug

# Bot Service Configuration
BOT_SERVICE_URL=http://localhost:8002
BOT_SERVICE_PORT=8002
BOT_SERVICE_LOG_LEVEL=info

# Scoring Service Configuration
SCORING_SERVICE_URL=http://localhost:8003
SCORING_SERVICE_PORT=8003
SCORING_SERVICE_LOG_LEVEL=warning

# Parser Service Configuration
PARSER_SERVICE_URL=http://localhost:8004
PARSER_SERVICE_PORT=8004
PARSER_SERVICE_LOG_LEVEL=error

PARSER_CELERY_BROKER_URL=redis://localhost:6379/0
PARSER_CELERY_RESULT_BACKEND=redis://localhost:6379/0
PARSER_REDIS_CONTAINER_NAME=juldyz-parser-redis
PARSER_REDIS_IMAGE=redis:7-alpine


# Telegram Bot Configuration
TELEGRAM_TOKEN=BOT_FATHER_TOKEN

# Google Form URL
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/GOOGLE_FORM_ID/viewform
QUESTION_FIELD_ID=GOOGLE_FORM_QUESTION_FIELD_ID